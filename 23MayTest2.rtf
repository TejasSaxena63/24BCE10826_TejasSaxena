Question1: List the Employee Name, their Department Name, and the Location Name for all employees.\
Answer1:\
SELECT e.employee_name, d.dept_name, d.location_id AS location_name\
FROM Employees e\
JOIN Departments d ON e.dept_id = d.dept_id;\
\
\
\
Question2: Retrieve the Project Name, Client Name, and the Total Hours Worked on that project, but only for projects managed by the 'Consulting' department.\
Answer2:\
SELECT p.project_name, p.client_name, SUM(a.hours_worked) AS total_hours_worked\
FROM Projects p\
JOIN Departments d ON p.dept_id = d.dept_id\
LEFT JOIN Assignments a ON p.project_id = a.project_id\
WHERE d.dept_name = 'Consulting'\
GROUP BY p.project_id, p.project_name, p.client_name;\
\
\
\
Question3: Find the names of Employees who have worked on a project with Client Name 'GlobalTech Solutions'. List the Employee Name and Project Name.\
Answer3:\
SELECT e.employee_name, p.project_name\
FROM Employees e\
JOIN Assignments a ON e.employee_id = a.employee_id\
JOIN Projects p ON a.project_id = p.project_id\
WHERE p.client_name = 'GlobalTech Solutions';\
\
\
\
Question4: List all Departments that have no Employees currently assigned to them.\
Answer4:\
SELECT d.dept_name\
FROM Departments d\
LEFT JOIN Employees e ON d.dept_id = e.dept_id\
WHERE e.employee_id IS NULL;\
\
\
\
Question5: Show the Manager Name, the Department Name they manage, and the total number of direct reports they have.\
Answer5:\
SELECT m.employee_name AS manager_name, d.dept_name, COUNT(e.employee_id) AS total_direct_reports\
FROM Employees m\
JOIN Employees e ON m.employee_id = e.manager_id\
JOIN Departments d ON m.dept_id = d.dept_id\
GROUP BY m.employee_id, m.employee_name, d.dept_name;\
\
\
\
Question6: Calculate the Average Hours Worked per Employee across all projects. List the Employee Name and the average hours.\
Answer6:\
SELECT e.employee_name, AVG(a.hours_worked) AS avg_hours_worked\
FROM Employees e\
JOIN Assignments a ON e.employee_id = a.employee_id\
GROUP BY e.employee_id, e.employee_name;\
\
\
\
Question7: Find the Department Name(s) that have an average salary above the company-wide average salary.\
Answer7:\
SELECT d.dept_name\
FROM Departments d\
JOIN Employees e ON d.dept_id = e.dept_id\
GROUP BY d.dept_id, d.dept_name\
HAVING AVG(e.salary) > (SELECT AVG(salary) FROM Employees);\
\
\
\
Question8: Identify the Client Name(s) whose projects have a total combined hours worked exceeding 500 hours.\
Answer8:\
SELECT p.client_name\
FROM Projects p\
JOIN Assignments a ON p.project_id = a.project_id\
GROUP BY p.client_name\
HAVING SUM(a.hours_worked) > 500;\
\
\
\
Question9: For each Location, find the Department Name with the highest count of employees.\
Answer9:\
SELECT d1.location_id, d1.dept_name\
FROM Departments d1\
JOIN Employees e1 ON d1.dept_id = e1.dept_id\
GROUP BY d1.location_id, d1.dept_id, d1.dept_name\
HAVING COUNT(e1.employee_id) = (\
    SELECT MAX(emp_count)\
    FROM (\
        SELECT d2.location_id, COUNT(e2.employee_id) AS emp_count\
        FROM Departments d2\
        JOIN Employees e2 ON d2.dept_id = e2.dept_id\
        GROUP BY d2.location_id, d2.dept_id\
    ) t\
    WHERE t.location_id = d1.location_id\
);\
\
\
\
Question10: Calculate the total number of employees assigned to each Project, but only include projects that have more than 5 employees assigned.\
Answer10:\
SELECT p.project_name, COUNT(DISTINCT a.employee_id) AS total_assigned_employees\
FROM Projects p\
JOIN Assignments a ON p.project_id = a.project_id\
GROUP BY p.project_id, p.project_name\
HAVING COUNT(DISTINCT a.employee_id) > 5;\
\
\
\
Question11: Find the Employee Name(s) who work on ALL projects managed by the 'R&D' department.\
Answer11:\
SELECT e.employee_name\
FROM Employees e\
JOIN Assignments a ON e.employee_id = a.employee_id\
JOIN Projects p ON a.project_id = p.project_id\
JOIN Departments d ON p.dept_id = d.dept_id\
WHERE d.dept_name = 'R&D'\
GROUP BY e.employee_id, e.employee_name\
HAVING COUNT(DISTINCT p.project_id) = (\
    SELECT COUNT(*) \
    FROM Projects p2\
    JOIN Departments d2 ON p2.dept_id = d2.dept_id\
    WHERE d2.dept_name = 'R&D'\
);\
\
\
\
Question12: Retrieve the Department Name(s) that have employees assigned to more than one project.\
Answer12:\
SELECT DISTINCT d.dept_name\
FROM Departments d\
JOIN Employees e ON d.dept_id = e.dept_id\
JOIN Assignments a ON e.employee_id = a.employee_id\
GROUP BY e.employee_id, d.dept_name\
HAVING COUNT(DISTINCT a.project_id) > 1;\
\
\
\
Question13: Write a query to list the Employee Name and Project Name for any employee who has worked less than 10 hours on a project.\
Answer13:\
SELECT e.employee_name, p.project_name\
FROM Employees e\
JOIN Assignments a ON e.employee_id = a.employee_id\
JOIN Projects p ON a.project_id = p.project_id\
WHERE a.hours_worked < 10;\
\
\
\
Question14: Find the Project Name(s) that have no assigned employees.\
Answer14:\
SELECT p.project_name\
FROM Projects p\
LEFT JOIN Assignments a ON p.project_id = a.project_id\
WHERE a.assignment_id IS NULL;\
\
\
\
Question15: Select the Employee Name(s) whose salary is greater than the maximum salary in their own department.\
Answer15:\
SELECT e1.employee_name\
FROM Employees e1\
WHERE e1.salary > (\
    SELECT MAX(e2.salary)\
    FROM Employees e2\
    WHERE e2.dept_id = e1.dept_id AND e2.employee_id <> e1.employee_id\
);\
\
\
\
Question16: Assuming the Assignments table has a start_date column, find the Employee Name and their oldest project start date.\
Answer16:\
SELECT e.employee_name, MIN(a.start_date) AS oldest_project_start_date\
FROM Employees e\
JOIN Assignments a ON e.employee_id = a.employee_id\
GROUP BY e.employee_id, e.employee_name;\
\
\
\
Question17: Write a MySQL query using the DATE_FORMAT function to list all projects that were active in the year 2023.\
Answer17:\
SELECT project_name\
FROM Projects\
WHERE DATE_FORMAT(start_date, '%Y') = '2023';\
\
\
\
Question18: Use the MySQL-specific IFNULL function to list all Employee Names. If an employee has no manager, display "CEO" instead of NULL.\
Answer18:\
SELECT employee_name, IFNULL(manager_id, 'CEO') AS manager_status\
FROM Employees;\
\
\
\
Question19: Find the top 3 Departments based on the total hours worked by all their employees across all projects.\
Answer19:\
SELECT d.dept_name, SUM(a.hours_worked) AS total_hours\
FROM Departments d\
JOIN Employees e ON d.dept_id = e.dept_id\
JOIN Assignments a ON e.employee_id = a.employee_id\
GROUP BY d.dept_id, d.dept_name\
ORDER BY total_hours DESC\
LIMIT 3;\
\
\
\
Question20: Display the Project Name and a status ("High Activity" if total hours > 300, "Normal" otherwise) using the CASE statement.\
Answer20:\
SELECT p.project_name,\
       CASE \
           WHEN SUM(a.hours_worked) > 300 THEN 'High Activity'\
           ELSE 'Normal'\
       END AS status\
FROM Projects p\
LEFT JOIN Assignments a ON p.project_id = a.project_id\
GROUP BY p.project_id, p.project_name;\
\
\
\
Question21: List the Employee Name and their Manager's Name, even if the employee has no manager, or if a potential manager has no employees reporting to them.\
Answer21:\
SELECT e.employee_name, m.employee_name AS manager_name\
FROM Employees e\
FULL OUTER JOIN Employees m ON e.manager_id = m.employee_id;\
\
\
\
Question22: Write a query using a Common Table Expression (CTE) to find the Project Name and the number of unique employees assigned to it.\
Answer22:\
WITH ProjectEmployeeCount AS (\
    SELECT project_id, COUNT(DISTINCT employee_id) AS unique_employee_count\
    FROM Assignments\
    GROUP BY project_id\
)\
SELECT p.project_name, IFNULL(pec.unique_employee_count, 0) AS unique_employees\
FROM Projects p\
LEFT JOIN ProjectEmployeeCount pec ON p.project_id = pec.project_id;\
\
\
\
Question23: Find the Employee Name(s) who are assigned to the same projects as Employee ID 101.\
Answer23:\
SELECT DISTINCT e.employee_name\
FROM Employees e\
JOIN Assignments a ON e.employee_id = a.employee_id\
WHERE a.project_id IN (\
    SELECT project_id \
    FROM Assignments\
    WHERE employee_id = 101\
) AND e.employee_id <> 101;}